{
  "expo": {
    "name": "VELYSH",
    "slug": "AppMovil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VELYSH necesita acceso a tus fotos para elegir tu imagen de perfil.",
          "cameraPermission": "VELYSH necesita la cámara para tomar tu foto de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ]
  }
}
